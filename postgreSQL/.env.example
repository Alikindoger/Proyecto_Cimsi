# ==============================================================================
# CONFIGURACIÓN DE POSTGRESQL - PROYECTO CIMSI
# ==============================================================================

# Nombre de la base de datos para el juego
POSTGRES_DB=cimsi_game

# Usuario administrador de la aplicación
POSTGRES_USER=cimsi_user

# Contraseña segura para el usuario
POSTGRES_PASSWORD=cimsi2627

# Puerto estándar interno de PostgreSQL
POSTGRES_PORT=5432

# Ruta de montaje del almacenamiento USB/SSD en el nodo Worker 1
# (Crucial en Raspberry Pi para evitar degradación de la tarjeta SD)
POSTGRES_SSD_PATH=/mnt/ssd/postgres_data

# Configuración de métricas Prometheus (Alfonso)
POSTGRES_EXPORTER_PORT=9187
